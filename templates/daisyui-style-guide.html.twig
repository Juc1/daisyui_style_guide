  {# 5. DYNAMIC FONT & TOKEN DETECTION (100% Fungible) #}
  <script>
    (function () {
      function detectActiveFonts() {
        // 1. Resolve active font family tokens from computed CSS styles
        var specimens = {
          sans: document.querySelector('.brand-guide .font-sans'),
          serif: document.querySelector('.brand-guide .font-serif'),
          mono: document.querySelector('.brand-guide .font-mono')
        };

        for (var key in specimens) {
          if (!specimens.hasOwnProperty(key)) continue;
          var el = specimens[key];
          if (!el) continue;

          var computed = window.getComputedStyle(el).fontFamily;
          if (!computed) continue;

          var cleanStack = computed.replace(/['"]/g, '').trim();
          var primaryFont = cleanStack.split(',')[0].trim();

          var titleEl = document.querySelector('[data-font-target="' + key + '"]');
          if (titleEl) {
            titleEl.textContent = primaryFont;
          }

          var stackEl = document.querySelector('[data-font-stack="' + key + '"]');
          if (stackEl) {
            stackEl.textContent = cleanStack;
          }
        }

        // 2. Resolve loaded web fonts via document.fonts CSS Font Loading API
        if ('fonts' in document) {
          document.fonts.ready.then(function () {
            var fontMap = {};
            var fontCount = 0;

            document.fonts.forEach(function (font) {
              var name = font.family.replace(/['"]/g, '').trim();
              if (!fontMap[name]) {
                fontMap[name] = [];
                fontCount++;
              }
              var label = font.weight + (font.style === 'italic' ? ' (italic)' : '');
              if (fontMap[name].indexOf(label) === -1) {
                fontMap[name].push(label);
              }
            });

            var container = document.getElementById('styleguide-registered-fonts');
            var countEl = document.getElementById('styleguide-font-count');

            if (container && fontCount > 0) {
              container.innerHTML = '';
              for (var fontName in fontMap) {
                if (!fontMap.hasOwnProperty(fontName)) continue;
                var badge = document.createElement('span');
                badge.className = 'badge badge-sm badge-outline gap-1.5 py-3 px-3 bg-base-100 shadow-2xs font-mono';
                var weightsStr = fontMap[fontName].join(', ');
                badge.innerHTML = '<strong class="text-foreground">' + fontName + '</strong> <span class="opacity-70 text-[11px]">[' + weightsStr + ']</span>';
                container.appendChild(badge);
              }
              if (countEl) {
                countEl.textContent = fontCount + ' web font' + (fontCount > 1 ? 's' : '') + ' loaded';
              }
            } else if (container) {
              container.innerHTML = '<span class="text-xs font-mono text-muted-foreground">Using system/native OS typography stacks</span>';
            }
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', detectActiveFonts);
      } else {
        detectActiveFonts();
      }
    })();
  </script>

